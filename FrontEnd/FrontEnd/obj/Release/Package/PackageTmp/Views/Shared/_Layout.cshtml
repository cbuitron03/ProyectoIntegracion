<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Ternura Infinita</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link rel="stylesheet" href="~/Content/Principal.css">

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark">
        <div class="container">
            @Html.ActionLink("Ternura Infinita", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Sobre Nosotros", "About", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Productos", "Index", "Productos", null, new { @class = "nav-link" })</li>
                    <li class="nav-item" id="navLogin">@Html.ActionLink("Iniciar Sesión", "InicioSesion", "Login", null, new { @class = "nav-link" })</li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <span id="usuarioNombre" class="nav-user nav-link"></span>
                    </li>
                    <li class="nav-item">
                        <a href="#" id="cerrarSesion" class="nav-link logout" style="display: none;">Cerrar sesión</a>
                    </li>
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Carrito1")" class="nav-link cart-icon" title="Ver carrito">
                            🛒
                            <span id="cart-count" class="cart-badge">0</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content mt-4">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Ternura Infinita. Todos los derechos reservados.</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <!-- Script para usuario logueado y contador carrito -->
<script>
    // Función global para actualizar el contador del carrito en la navbar
    function actualizarContadorCarrito() {
        const carrito = JSON.parse(sessionStorage.getItem("carrito")) || [];
        const cantidadTotal = carrito.reduce((acc, item) => acc + (parseInt(item.cantidad) || 0), 0);
        const contadorNavbar = $("#cart-count");

        if (cantidadTotal > 0) {
            contadorNavbar.text(cantidadTotal).fadeIn(100);

            // Animación simple para llamar la atención
            contadorNavbar.addClass("contador-animado");
            setTimeout(() => contadorNavbar.removeClass("contador-animado"), 300);
        } else {
            contadorNavbar.fadeOut(100);
        }
    }

    // Hacer accesible la función globalmente
    window.actualizarContadorCarrito = actualizarContadorCarrito;

    // Ejecutar al cargar la página
    $(document).ready(function () {
        // Leer datos del usuario
        const usuarioJSON = sessionStorage.getItem("usuarioActual");
        if (usuarioJSON) {
            const usuarioObj = JSON.parse(usuarioJSON);
            // Aquí puedes elegir qué mostrar: usuarioObj.US_NOMBRE o usuarioObj.US_CEDULA o lo que tengas
            const nombreMostrar = usuarioObj.US_NOMBRE || usuarioObj.US_USUARIO || usuarioObj.US_CEDULA || "Usuario";

            $("#usuarioNombre").text(`👤 ${nombreMostrar}`);
            $("#cerrarSesion").show();
            $("#navLogin").hide();
        } else {
            $("#usuarioNombre").text("");
            $("#cerrarSesion").hide();
            $("#navLogin").show();
        }

        // Cerrar sesión
        $("#cerrarSesion").click(function (e) {
            e.preventDefault();
            sessionStorage.clear();
            location.href = "/Login/InicioSesion";
        });

        actualizarContadorCarrito();
    });
</script>
</body>
</html>
