@model IEnumerable<FrontEnd.Models.Usuarios>

@{
    ViewBag.Title = "Usuarios";
}

<link rel="stylesheet" href="~/Content/Gestion.css">
<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@Url.Action("Index", "Gestion")">Panel de Gestión</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")">Cerrar sesión</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <h2 class="mb-4">Usuarios</h2>

    <div class="d-flex justify-content-between mb-3">
        <button class="btn btn-primary" onclick="crearUsuario()">
            <i class="bi bi-plus-circle"></i> Crear Nuevo
        </button>

        <input type="text" id="searchInput" class="form-control w-25" placeholder="Buscar usuario..." onkeyup="filtrarTabla()">
    </div>

    <div id="spinner" class="text-center my-4" style="display:none;">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <div id="errorMsg" class="alert alert-danger d-none" role="alert">
        Error al obtener los usuarios. Intente más tarde.
    </div>

    <table class="table table-striped table-hover align-middle" id="tablaUsuarios">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Usuario</th>
                <th>Contraseña</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <!-- Datos cargados vía jQuery -->
        </tbody>
    </table>
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="mb-0">&copy; @DateTime.Now.Year AdminDB. Todos los derechos reservados.</p>
</footer>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        cargarUsuarios();
    });

    function cargarUsuarios() {
        $('#spinner').show();
        $('#errorMsg').addClass('d-none');

        $.ajax({
            url: 'https://backendternurainfinita.runasp.net/api/Usuarios',
            method: 'GET',
            dataType: 'json',
            success: function (data) {
                $('#spinner').hide();
                const tbody = $('#tablaUsuarios tbody');
                tbody.empty();

                if (data.length === 0) {
                    tbody.append('<tr><td colspan="6" class="text-center">No se encontraron usuarios.</td></tr>');
                    return;
                }

                data.forEach(function (usuario) {
                    let fila = `
                    <tr>
                        <td>${usuario.US_COD}</td>
                        <td>${usuario.US_USUARIO}</td>
                        <td>
                            <input type="password" class="form-control form-control-sm d-inline-block" value="${usuario.US_PASS}" readonly style="width:130px;" id="pass-${usuario.US_COD}">
                            <button class="btn btn-outline-secondary btn-sm ms-1" onclick="togglePassword('${usuario.US_COD}')">
                                <i class="bi bi-eye"></i>
                            </button>
                        </td>
                        <td>${usuario.US_ROL}</td>
                        <td>${usuario.US_ESTADO ?? 'N/A'}</td>
                        <td>
                            <button class="btn btn-warning btn-sm me-1" title="Editar" onclick="editarUsuario('${usuario.US_USUARIO}')">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-danger btn-sm" title="Eliminar" onclick="desactivarUsuario('${usuario.US_USUARIO}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>`;
                    tbody.append(fila);
                });
            },
            error: function () {
                $('#spinner').hide();
                $('#errorMsg').removeClass('d-none');
            }
        });
    }

    function togglePassword(codigo) {
        const input = $(`#pass-${codigo}`);
        if (input.attr('type') === 'password') {
            input.attr('type', 'text');
        } else {
            input.attr('type', 'password');
        }
    }

    function editarUsuario(usuarioCedula) {
        window.location.href = `/GesUsuarios/Edit?usuario=${encodeURIComponent(usuarioCedula)}`;
    }

    function desactivarUsuario(usuario) {
        if (confirm(`¿Estás seguro de desactivar al usuario ${usuario}?`)) {
            $.ajax({
                url: `https://backendternurainfinita.runasp.net/api/Usuarios?usuario=${encodeURIComponent(usuario)}`,
                method: 'DELETE', // o PATCH, dependiendo de lo que acepte tu backend
                contentType: 'application/json',
                data: JSON.stringify({ activo: false }), // ajusta el nombre del campo según tu modelo
                success: function () {
                    alert("Usuario desactivado correctamente.");
                    cargarUsuarios(); // refrescar la tabla o lista
                },
                error: function (xhr) {
                    alert("Error al desactivar el usuario: " + (xhr.responseText || "Error desconocido"));
                }
            });
        }
    }


    function crearUsuario() {
        window.location.href = `/GesUsuarios/Create`;
    }

    function filtrarTabla() {
        const filtro = $('#searchInput').val().toLowerCase();
        $('#tablaUsuarios tbody tr').filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(filtro) > -1)
        });
    }
</script>
