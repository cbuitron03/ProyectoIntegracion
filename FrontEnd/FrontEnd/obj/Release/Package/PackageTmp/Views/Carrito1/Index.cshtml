@model FrontEnd.Models.Carrito1

@{
    ViewBag.Title = "Index";
}

<h2 class="text-center mb-4">🛍️ Tu Carrito</h2>

<div id="carrito-container" class="table-responsive shadow-sm p-3 mb-5 bg-body rounded">
    <table class="table table-bordered table-striped text-center align-middle" id="tabla-carrito">
        <thead class="table-danger">
            <tr>
                <th>Producto</th>
                <th>Imagen</th>
                <th>Precio Unitario</th>
                <th>Cantidad</th>
                <th>Subtotal</th>
                <th>Quitar</th>
            </tr>
        </thead>
        <tbody id="carrito-body">
            <tr>
                <td colspan="6" class="text-center py-4 text-muted">
                    Cargando productos del carrito...
                    <div class="spinner-border spinner-border-sm ms-2"></div>
                </td>
            </tr>
        </tbody>
    </table>

    <div id="carrito-resumen" class="mt-4" style="display: none;">
        <div class="text-end me-3 mb-2">
            <h5>Subtotal: $<span id="carrito-subtotal">0.00</span></h5>
            <h5>IVA (15%): $<span id="carrito-iva">0.00</span></h5>
            <h4><strong>Total: $<span id="carrito-total">0.00</span></strong></h4>
            <small class="text-muted">(Impuestos incluidos)</small>
        </div>

        <div class="text-end me-3 mt-3">
            <button id="btnComprar" class="btn btn-success btn-lg">
                <i class="fas fa-check-circle me-2"></i> Finalizar compra
            </button>
        </div>
    </div>
</div>

<!-- Tu modal en HTML -->
<div class="modal fade" id="modalBanco" tabindex="-1" aria-labelledby="modalBancoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalBancoLabel">¿Tienes cuenta bancaria?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                Para continuar con la compra, necesitamos saber si tienes cuenta en el banco.
            </div>
            <div class="modal-footer">
                <button id="btnSiBanco" type="button" class="btn btn-primary">Sí</button>
                <button id="btnNoBanco" type="button" class="btn btn-secondary">No</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let carritoActual = [];

        function renderCarrito() {
            carritoActual = JSON.parse(sessionStorage.getItem("carrito")) || [];
            const body = document.getElementById("carrito-body");
            const totalElem = document.getElementById("carrito-total");
            const resumenDiv = document.getElementById("carrito-resumen");

            body.innerHTML = "";
            let subtotalGeneral = 0;

            if (carritoActual.length === 0) {
                body.innerHTML = `
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        🛒 Tu carrito está vacío 😿
                                        <br/>
                                        <a href="/Productos/Index" class="btn btn-outline-primary mt-3">Ver Productos</a>
                                    </td>
                                </tr>`;
                totalElem.textContent = "0.00";
                resumenDiv.style.display = 'none';
                return;
            }

            resumenDiv.style.display = 'block';

            carritoActual.forEach((item, index) => {
                const precio = parseFloat(item.precio) || 0;
                const cantidad = parseInt(item.cantidad) || 0;
                const subtotalItem = precio * cantidad;
                subtotalGeneral += subtotalItem;

                const fila = document.createElement("tr");
                fila.innerHTML = `
                                <td>${item.nombre}</td>
                                <td><img src="${item.imagen}" width="60" class="img-thumbnail" /></td>
                                <td>$${precio.toFixed(2)}</td>
                                <td>${cantidad}</td>
                                <td>$${subtotalItem.toFixed(2)}</td>
                                <td><button class="btn btn-sm btn-outline-danger" onclick="quitarProducto(${index})">Quitar</button></td>`;
                body.appendChild(fila);
            });

            const iva = subtotalGeneral * 0.15;
            const total = subtotalGeneral + iva;

            document.getElementById("carrito-subtotal").innerText = subtotalGeneral.toFixed(2);
            document.getElementById("carrito-iva").innerText = iva.toFixed(2);
            totalElem.textContent = total.toFixed(2);
        }

        function quitarProducto(index) {
            let carrito = JSON.parse(sessionStorage.getItem("carrito")) || [];
            carrito.splice(index, 1);
            sessionStorage.setItem("carrito", JSON.stringify(carrito));
            renderCarrito();
        }

        function verificarAutenticacionAntesDeComprar() {
            const usuario = JSON.parse(sessionStorage.getItem("usuarioActual"));
            if (usuario && usuario.US_USUARIO) {
                finalizarCompra(usuario.US_USUARIO);
            } else {
                sessionStorage.setItem("carritoPendiente", JSON.stringify(carritoActual));
                window.location.href = "/Login/InicioSesion?requiereCompra=true";
            }
        }

        async function finalizarCompra(cedulaCliente) {
            const carrito = JSON.parse(sessionStorage.getItem("carrito")) || [];

            if (carrito.length === 0) {
                alert("Tu carrito está vacío.");
                return;
            }

            const productos = carrito.map(item => ({
                idProducto: item.id,
                cantidad: item.cantidad
            }));

            const datosCompra = {
                carrito: { productos },
                direccion: "Calle Falsa 123, Ciudad",
                metodoPago: "Tarjeta de Crédito",
                cliente: {
                    cliCedula: cedulaCliente
                }
            };

            try {
                const respuesta = await fetch("https://backendternurainfinita.runasp.net/api/integracion/compra", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(datosCompra)
                });

                if (!respuesta.ok) throw new Error("Error al crear la compra");

                const facturaId = await respuesta.json();

                sessionStorage.setItem("facturaGenerada", facturaId);
                sessionStorage.setItem("clienteCedula", cedulaCliente);

                const modalBanco = new bootstrap.Modal(document.getElementById("modalBanco"));
                modalBanco.show();

            } catch (error) {
                alert("Error al realizar la compra: " + error.message);
            }
        }

        document.getElementById("btnSiBanco").addEventListener("click", async () => {
            const facCod = sessionStorage.getItem("facturaGenerada");
            const cedula = sessionStorage.getItem("clienteCedula");

            try {
                const response = await fetch(`https://backendternurainfinita.runasp.net/api/banco/transaccion?cliCedula=${cedula}&facCod=${facCod}`, {
                    method: "POST", // Cambiado a POST
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({}) // Enviando body vacío
                });

                if (!response.ok) throw new Error("Error en la transacción bancaria");

                const resultado = await response.json();

                if (resultado === true) {
                    alert("✅ Transacción completada con éxito.");
                    sessionStorage.removeItem("carrito");
                    renderCarrito();
                } else {
                    alert("❌ Transacción fallida. Contacte con su banco.");
                }

            } catch (error) {
                alert("Error al realizar la transacción: " + error.message);
            }

            bootstrap.Modal.getInstance(document.getElementById("modalBanco")).hide();
        });

        document.getElementById("btnNoBanco").addEventListener("click", () => {
            alert("❌ Lamentamos, pero necesitas tener una cuenta bancaria para completar la compra.");
            bootstrap.Modal.getInstance(document.getElementById("modalBanco")).hide();
        });

        document.addEventListener("DOMContentLoaded", function () {
            renderCarrito();

            document.getElementById("btnComprar").addEventListener("click", function (e) {
                e.preventDefault();
                verificarAutenticacionAntesDeComprar();
            });

            const params = new URLSearchParams(window.location.search);
            if (params.get("requiereCompra") === "true") {
                const pendiente = JSON.parse(sessionStorage.getItem("carritoPendiente"));
                if (pendiente) {
                    sessionStorage.setItem("carrito", JSON.stringify(pendiente));
                    sessionStorage.removeItem("carritoPendiente");
                    renderCarrito();
                }
            }
        });
    </script>
}
