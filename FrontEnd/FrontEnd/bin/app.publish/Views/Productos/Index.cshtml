@{
    ViewBag.Title = "Productos";
}

<link rel="stylesheet" href="~/Content/Principal.css">

<h2 class="titulo-productos">Nuestros Productos</h2>

<div class="productos-container" id="productosContainer">
    <!-- Productos cargados dinámicamente -->
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            $.ajax({
                url: 'https://backendternurainfinita.runasp.net/api/integracion/productos',
                type: 'GET',
                dataType: 'json',
                success: function (productos) {
                    renderizarProductos(productos);
                },
                error: function () {
                    alert("Error al obtener los productos.");
                }
            });

            function renderizarProductos(productos) {
                const contenedor = $("#productosContainer");
                contenedor.empty();

                productos.forEach(producto => {
                    const id = producto.idProducto;
                    const idCarrusel = `carousel-${id}`;
                    const imagenes = Array.isArray(producto.prodImg) && producto.prodImg.length > 0
                        ? producto.prodImg
                        : ["/images/default-placeholder.png"];

                    const imagenesHtml = imagenes.map((url, i) =>
                        `<div class="carousel-item ${i === 0 ? 'active' : ''}">
                                <img src="${url}" class="d-block w-100" alt="Imagen de ${producto.prodDescripcion}">
                            </div>`
                    ).join('');

                    const controles = imagenes.length > 1
                        ? `<button class="carousel-control-prev" type="button" data-bs-target="#${idCarrusel}" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Anterior</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#${idCarrusel}" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Siguiente</span>
                                </button>`
                        : '';

                    const stock = producto.prodStock ?? 0;

                    const html = `
                            <div class="producto-card">
                                <div class="producto-nombre">${escapeHtml(producto.prodNombre)}</div>

                                <div id="${idCarrusel}" class="carousel slide" data-bs-ride="carousel" style="width:100%;">
                                    <div class="carousel-inner">${imagenesHtml}</div>
                                    ${controles}
                                </div>

                                <div class="producto-descripcion">${escapeHtml(producto.prodDescripcion)}</div>

                                <p class="precio">$${parseFloat(producto.prodPrecio).toFixed(2)}</p>

                                <p style="color: ${stock > 0 ? '#28a745' : '#dc3545'}; font-weight: bold;">
                                    ${stock > 0 ? `Stock disponible: ${stock}` : 'Agotado'}
                                </p>

                                <div class="cart-controls">
                                    <div class="qty-group">
                                        <label class="qty-label" for="qty-${id}">Cantidad:</label>
                                        <input type="number" id="qty-${id}" min="1" max="${stock}" value="1" class="qty-input" ${stock <= 0 ? 'disabled' : ''} />
                                    </div>
                                    <button class="btn btn-outline-pink"
                                            onclick="addToCart(${id}, '${escapeJs(producto.prodNombre)}', ${producto.prodPrecio}, ${stock})"
                                            ${stock <= 0 ? 'disabled' : ''}>
                                        🧸 Agregar al carrito
                                    </button>
                                </div>
                            </div>`;

                    contenedor.append(html);
                });
            }

            function escapeJs(text) {
                return text.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"');
            }

            function escapeHtml(text) {
                return text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#39;");
            }

            window.addToCart = function (id, nombre, precio, stock) {
                const cantidad = parseInt($(`#qty-${id}`).val()) || 1;

                if (cantidad > stock) {
                    alert(`Solo hay ${stock} unidades disponibles.`);
                    return;
                }

                const imagen = $(`#carousel-${id} .carousel-item.active img`).attr('src') ||
                    $(`#carousel-${id} .carousel-item img`).first().attr('src') ||
                    '/images/default-placeholder.png';

                let carrito = JSON.parse(sessionStorage.getItem("carrito")) || [];
                const index = carrito.findIndex(p => p.id === id);

                if (index !== -1) {
                    const nuevaCantidad = carrito[index].cantidad + cantidad;

                    if (nuevaCantidad > stock) {
                        alert(`Ya tienes ${carrito[index].cantidad} en el carrito. Solo puedes agregar ${stock - carrito[index].cantidad} más.`);
                        return;
                    }

                    carrito[index].cantidad = nuevaCantidad;
                } else {
                    carrito.push({ id, nombre, precio: parseFloat(precio), cantidad, imagen });
                }

                sessionStorage.setItem("carrito", JSON.stringify(carrito));

                if (typeof actualizarCarritoUI === "function") {
                    actualizarContadorCarrito();
                }

                $(`#qty-${id}`).val(1);
            };
        });
    </script>
}

