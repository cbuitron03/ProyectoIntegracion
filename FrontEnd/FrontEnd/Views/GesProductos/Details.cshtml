@{
    ViewBag.Title = "Detalles del Producto";
    var idProducto = ViewBag.ProductoId;
}

<link rel="stylesheet" href="~/Content/Gestion.css">
<h2 class="mb-4 text-center text-primary fw-bold">
    <i class="bi bi-box-seam me-2"></i> Detalles del Producto
</h2>

<link rel="stylesheet" href="~/Content/Gestion.css">

<style>
    #detalleProducto {
        max-width: 900px;
        margin: 0 auto 40px;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
        background: #fff;
        padding: 30px;
    }

    #infoProducto p {
        font-size: 1.05rem;
        margin-bottom: 0.6rem;
    }

    #infoProducto strong {
        color: #333;
    }

    #galeriaImagenes .card {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease;
        cursor: pointer;
    }

        #galeriaImagenes .card:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 20px rgba(0, 123, 255, 0.3);
            z-index: 5;
        }

    #galeriaImagenes img {
        border-radius: 12px;
        object-fit: cover;
        height: 180px;
        width: 100%;
    }

    .btn-volver {
        display: block;
        max-width: 150px;
        margin: 0 auto;
    }
</style>
<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@Url.Action("Index", "Gestion")">Panel de Gestión</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")">Cerrar sesión</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
<div id="detalleProducto" class="bg-white">
    <div class="row">
        <div class="col-lg-5 mb-4">
            <h3 id="prodNombre" class="text-primary fw-bold"></h3>
            <p><strong>Categoría:</strong> <span id="prodCategoria"></span></p>
            <p><strong>Descripción:</strong> <span id="prodDescripcion"></span></p>
            <p><strong>Precio:</strong> <span class="text-success fw-semibold fs-5">$<span id="prodPrecio"></span></span></p>
            <p><strong>Stock:</strong> <span id="prodStock"></span> unidades</p>
            <p><strong>Proveedor:</strong> <span id="prodProveedor"></span></p>
        </div>

        <div class="col-lg-7">
            <h5 class="mb-3 text-center text-secondary">Galería de Imágenes</h5>
            <div class="row" id="galeriaImagenes"></div>
        </div>
    </div>

    <a href="@Url.Action("Index", "GesProductos")" class="btn btn-outline-primary btn-volver mt-4">
        <i class="bi bi-arrow-left-circle me-2"></i> Volver
    </a>
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="mb-0">&copy; @DateTime.Now.Year AdminDB. Todos los derechos reservados.</p>
</footer>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-- Bootstrap Icons CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<script>
    $(function () {
        const id = '@idProducto';

        $.ajax({
            url: `https://backendternurainfinita.runasp.net/api/integracion/productos/${id}`,
            method: 'GET',
            success: function (producto) {
                $('#prodNombre').text(producto.prodNombre || 'Sin nombre');
                $('#prodCategoria').text(producto.prodCategoria || 'N/A');
                $('#prodDescripcion').text(producto.prodDescripcion || 'N/A');
                $('#prodPrecio').text(producto.prodPrecio?.toFixed(2) || '0.00');
                $('#prodStock').text(producto.prodStock || '0');
                $('#prodProveedor').text(producto.prodProveedor || 'N/A');

                const galeria = $('#galeriaImagenes');
                galeria.empty();

                if (producto.prodImg && producto.prodImg.length > 0) {
                    producto.prodImg.forEach(function (url) {
                        const imgCard = `
                            <div class="col-6 col-md-4 mb-3">
                                <div class="card shadow-sm">
                                    <img src="${url}" alt="Imagen del producto" loading="lazy">
                                </div>
                            </div>`;
                        galeria.append(imgCard);
                    });
                } else {
                    galeria.html('<p class="text-muted text-center">No hay imágenes disponibles.</p>');
                }
            },
            error: function () {
                alert("Error al cargar los detalles del producto.");
            }
        });
    });
</script>
