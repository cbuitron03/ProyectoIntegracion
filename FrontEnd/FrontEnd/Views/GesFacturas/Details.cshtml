@{
    ViewBag.Title = "Detalles de la Factura";
    var idFactura = ViewBag.FacturaId;
}

<link rel="stylesheet" href="~/Content/Gestion.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<style>
    .invoice-box {
        background: #fff;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .invoice-header {
        border-bottom: 1px solid #eaeaea;
        margin-bottom: 20px;
    }

    .invoice-title {
        font-size: 28px;
        font-weight: 700;
    }

    .invoice-subtitle {
        color: #888;
    }

    .table th, .table td {
        vertical-align: middle;
    }
</style>
<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@Url.Action("Index", "Gestion")">Panel de Gestión</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")">Cerrar sesión</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
<div class="container mt-5">
    <div class="invoice-box">
        <div id="spinner" class="text-center my-4" style="display:none;">
            <div class="spinner-border text-primary" role="status"></div>
        </div>

        <div id="errorMsg" class="alert alert-danger d-none" role="alert">
            Error al obtener los detalles de la factura. Intente más tarde.
        </div>

        <div id="facturaDetalles" class="d-none">
            <div class="invoice-header d-flex justify-content-between align-items-center">
                <div>
                    <div class="invoice-title">Factura #<span id="facCodigo"></span></div>
                    <div class="invoice-subtitle">Fecha: <span id="facFecha"></span></div>
                    <div class="invoice-subtitle">Estado: <span id="facEstado"></span></div>
                </div>

            </div>

            <h5 class="mt-4">Datos del Cliente</h5>
            <ul class="list-group mb-4">
                <li class="list-group-item"><strong>Cédula:</strong> <span id="clienteCedula"></span></li>
                <li class="list-group-item"><strong>Nombre:</strong> <span id="clienteNombre"></span></li>
                <li class="list-group-item"><strong>Correo:</strong> <span id="clienteCorreo"></span></li>
                <li class="list-group-item"><strong>Teléfono:</strong> <span id="clienteTelefono"></span></li>
                <li class="list-group-item"><strong>Dirección:</strong> <span id="clienteDireccion"></span></li>
            </ul>

            <h5>Detalle de Productos</h5>
            <table class="table table-striped" id="tablaDetalles">
                <thead class="table-dark">
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

            <div class="text-end">
                <p><strong>Subtotal:</strong> $<span id="facSubtotal"></span></p>
                <p><strong>IVA:</strong> $<span id="facIva"></span></p>
                <p><strong>Total:</strong> $<span id="facTotal" class="text-success fs-5"></span></p>
            </div>

            <button class="btn btn-secondary mt-3" onclick="volverAtras()">Volver</button>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="mb-0">&copy; @DateTime.Now.Year AdminDB. Todos los derechos reservados.</p>
</footer>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        const id = '@idFactura';

        $('#spinner').show();

        $.ajax({
            url: `https://backendternurainfinita.runasp.net/api/Facturas/${id}`,
            method: 'GET',
            dataType: 'json',
            success: function (factura) {
                $('#facCodigo').text(factura.FAC_COD);
                $('#clienteCedula').text(factura.CLI_CEDULA);
                $('#facFecha').text(new Date(factura.FAC_FECHA).toLocaleString('es-EC'));
                $('#facEstado').text(factura.FAC_ESTADO);
                $('#facSubtotal').text(factura.FAC_SUBTOTAL.toFixed(2));
                $('#facIva').text(factura.FAC_IVA.toFixed(2));
                $('#facTotal').text(factura.FAC_TOTAL.toFixed(2));
                $('#facTotalBottom').text(factura.FAC_TOTAL.toFixed(2));


                obtenerCliente(factura.CLI_CEDULA);
                cargarDetalles(id);
            },
            error: function () {
                $('#spinner').hide();
                $('#errorMsg').removeClass('d-none');
            }
        });
    });

    function obtenerCliente(cedula) {
        $.ajax({
            url: `https://backendternurainfinita.runasp.net/api/Clientes?cedula=${cedula}`,
            method: 'GET',
            dataType: 'json',
            success: function (cliente) {
                $('#clienteNombre').text(cliente.CLI_NOMBRE);
                $('#clienteCorreo').text(cliente.CLI_CORREO);
                $('#clienteTelefono').text(cliente.CLI_TELEFONO);
                $('#clienteDireccion').text(cliente.CLI_DIRECCION);

                $('#spinner').hide();
                $('#facturaDetalles').removeClass('d-none');
            },
            error: function () {
                $('#spinner').hide();
                $('#errorMsg').removeClass('d-none');
            }
        });
    }

    function cargarDetalles(idFactura) {
        $.ajax({
            url: `https://backendternurainfinita.runasp.net/api/DetalleFactura/${idFactura}`,
            method: 'GET',
            dataType: 'json',
            success: function (detalles) {
                const tbody = $('#tablaDetalles tbody');
                tbody.empty();

                if (!detalles || detalles.length === 0) {
                    tbody.append('<tr><td colspan="4" class="text-center">No hay productos.</td></tr>');
                    return;
                }

                detalles.forEach(function (detalle) {
                    // Llamada a la API para obtener nombre del producto
                    $.ajax({
                        url: `https://backendternurainfinita.runasp.net/api/Productos/${detalle.PRD_COD}`,
                        method: 'GET',
                        dataType: 'json',
                        success: function (producto) {
                            const row = `
                            <tr>
                                <td>${producto.PRD_NOMBRE}</td>
                                <td>${detalle.DTF_CANTIDAD}</td>
                                <td>$${detalle.DTF_PRECIO.toFixed(2)}</td>
                                <td>${detalle.DTF_ESTADO}</td>
                            </tr>`;
                            tbody.append(row);
                        },
                        error: function () {
                            const row = `
                            <tr>
                                <td>Error al cargar producto #${detalle.PRD_COD}</td>
                                <td>${detalle.DTF_CANTIDAD}</td>
                                <td>$${detalle.DTF_PRECIO.toFixed(2)}</td>
                                <td>${detalle.DTF_ESTADO}</td>
                            </tr>`;
                            tbody.append(row);
                        }
                    });
                });
            },
            error: function () {
                $('#errorMsg').removeClass('d-none');
            }
        });
    }


    function volverAtras() {
        window.history.back();
    }
</script>
