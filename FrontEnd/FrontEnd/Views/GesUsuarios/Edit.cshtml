@{
    ViewBag.Title = "Editar Usuario";
    var usuarioCedula = ViewBag.Usuario;
}

<link rel="stylesheet" href="~/Content/Gestion.css">
<h2 class="mb-4 text-center">Editar Usuario</h2>

<link rel="stylesheet" href="~/Content/Gestion.css">
<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@Url.Action("Index", "Gestion")">Panel de Gestión</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")">Cerrar sesión</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container d-flex justify-content-center">
    <form id="formEditarUsuario" novalidate style="max-width: 420px; width: 100%;">
        <div class="mb-3">
            <label for="US_COD" class="form-label">Código</label>
            <input type="number" id="US_COD" name="US_COD" class="form-control form-control-sm" readonly>
        </div>

        <div class="mb-3">
            <label for="US_USUARIO" class="form-label">Cédula (Usuario)</label>
            <input type="text" id="US_USUARIO" name="US_USUARIO" class="form-control form-control-sm">
        </div>

        <div class="mb-3">
            <label for="US_PASS" class="form-label">Contraseña</label>
            <input type="text" id="US_PASS" name="US_PASS" class="form-control form-control-sm" required minlength="4" placeholder="Mínimo 4 caracteres">
            <div class="invalid-feedback">La contraseña es requerida (mínimo 4 caracteres).</div>
        </div>

        <div class="mb-3">
            <label for="US_ROL" class="form-label">Rol</label>
            <select id="US_ROL" name="US_ROL" class="form-select form-select-sm" required>
                <option value="" disabled>-- Seleccione un rol --</option>
                <option value="cliente">Cliente</option>
                <option value="administrador">Administrador</option>
            </select>
            <div class="invalid-feedback">Seleccione un rol.</div>
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success btn-sm" id="btnGuardar">Guardar Cambios</button>
            <a href="@Url.Action("Index", "GesUsuarios")" class="btn btn-secondary btn-sm">Cancelar</a>
        </div>
    </form>
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="mb-0">&copy; @DateTime.Now.Year AdminDB. Todos los derechos reservados.</p>
</footer>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(function () {
        const usuarioCedula = '@usuarioCedula';

        // Cargar datos
        $.ajax({
            url: `https://backendternurainfinita.runasp.net/api/Usuarios?usuario=${encodeURIComponent(usuarioCedula)}`,
            method: 'GET',
            success: function (usuario) {
                $('#US_COD').val(usuario.US_COD);
                $('#US_USUARIO').val(usuario.US_USUARIO);
                $('#US_PASS').val(usuario.US_PASS);
                $('#US_ROL').val(usuario.US_ROL);

                const estado = (usuario.US_ESTADO || '').toLowerCase();
                if (estado === "activo" || estado === "inactivo") {
                    $('#US_ESTADO').val(estado);
                } else {
                    $('#US_ESTADO').append(`<option selected>${usuario.US_ESTADO}</option>`);
                }
            },
            error: function () {
                alert("Error al cargar los datos del usuario.");
            }
        });

        // Enviar cambios
        $('#formEditarUsuario').on('submit', function (e) {
            e.preventDefault();

            const passInput = $('#US_PASS');
            const rolInput = $('#US_ROL');
            let valid = true;

            passInput.removeClass('is-invalid');
            rolInput.removeClass('is-invalid');

            if (!passInput.val() || passInput.val().length < 4) {
                passInput.addClass('is-invalid');
                valid = false;
            }

            if (!rolInput.val()) {
                rolInput.addClass('is-invalid');
                valid = false;
            }

            if (!valid) return;

            const btnGuardar = $('#btnGuardar');
            btnGuardar.prop('disabled', true).text('Guardando...');

            const datos = {
                US_COD: parseInt($('#US_COD').val()),
                US_USUARIO: $('#US_USUARIO').val().trim(),
                US_PASS: passInput.val().trim(),
                US_ROL: rolInput.val(),
                US_ESTADO: $('#US_ESTADO').val(), // Aunque esté deshabilitado, lo enviamos
                CLIENTE: []
            };

            $.ajax({
                url: 'https://backendternurainfinita.runasp.net/api/Usuarios',
                method: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(datos),
                success: function (res) {
                    if (res === true || res === "true") {
                        alert("Usuario actualizado correctamente.");
                        window.location.href = '@Url.Action("Index", "GesUsuarios")';
                    } else {
                        alert("No se pudo actualizar el usuario.");
                        btnGuardar.prop('disabled', false).text('Guardar Cambios');
                    }
                },
                error: function (xhr) {
                    alert("Error al actualizar usuario: " + xhr.responseText);
                    btnGuardar.prop('disabled', false).text('Guardar Cambios');
                }
            });
        });
    });
</script>
