@model FrontEnd.Models.Login

@{
    ViewBag.Title = "InicioSesion";
}

<div class="container mt-5" style="max-width: 480px;">
    <div class="text-center mb-4">
        <img src="https://res.cloudinary.com/dvmxzzsj2/image/upload/v1746092699/Imagen_de_WhatsApp_2025-05-01_a_las_04.43.53_d579ddc9_qlpice.jpg" alt="Ternura Infinita" style="width: 100px;" />
        <h2 class="mt-3" style="color: #e91e63; font-weight: bold;">Bienvenido a Ternura Infinita</h2>
        <p class="text-muted">Ingresa tus datos para continuar</p>
    </div>

    <div class="card shadow-lg p-4 rounded-4">
        <h4 class="text-center mb-4" style="color: #e91e63; font-weight: bold;">Iniciar Sesión</h4>

        <!-- Formulario con AJAX -->
        <form id="loginForm">
            <div class="form-group mb-3">
                <label for="usuario" class="form-label">Usuario</label>
                <input type="text" name="usuario" id="usuario" class="form-control form-control-lg" placeholder="Ingrese su usuario" required />
            </div>

            <div class="form-group mb-4">
                <label for="clave" class="form-label">Contraseña</label>
                <input type="password" name="clave" id="clave" class="form-control form-control-lg" placeholder="Ingrese su contraseña" required />
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Iniciar Sesión</button>
            </div>
        </form>

        <hr class="my-4" />
        <p class="text-center text-muted">¿No tienes cuenta?</p>
        <div class="d-grid">
            <a href="@Url.Action("Cuenta", "Login")" class="btn btn-outline-secondary btn-lg">Registrarse</a>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/Content/Principal.css">

<!-- Script con AJAX y depuración -->
@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            $("#loginForm").submit(function (e) {
                e.preventDefault();

                const usuario = $("#usuario").val().trim();
                const clave = $("#clave").val().trim();

                if (!usuario || !clave) {
                    alert("Por favor, complete todos los campos.");
                    return;
                }

                const url = `https://backendternurainfinita.runasp.net/api/autenticarUsuario?US_USUARIO=${encodeURIComponent(usuario)}&US_PASS=${encodeURIComponent(clave)}`;

                $.ajax({
                    url: url,
                    method: "GET",
                    dataType: "text",
                    success: function (respuesta) {
                        const autenticado = respuesta.toString().trim().toLowerCase() === "true";

                        if (autenticado) {
                            alert("Inicio de sesión exitoso 🎉");

                            // 🔐 Recuperar datos del usuario autenticado
                            $.ajax({
                                url: `https://backendternurainfinita.runasp.net/api/Usuarios?usuario=${encodeURIComponent(usuario)}`,
                                method: "GET",
                                success: function (usuarioData) {
                                    if (usuarioData && usuarioData.US_USUARIO) {
                                        sessionStorage.setItem("usuarioActual", JSON.stringify(usuarioData));

                                        // 🔁 Si se venía desde carrito, redirigir ahí
                                        const params = new URLSearchParams(window.location.search);
                                        if (params.get("requiereCompra") === "true") {
                                            window.location.href = "/Carrito1/Index";
                                        } else {
                                            window.location.href = "/Home/Index";
                                        }
                                    } else {
                                        alert("No se pudo recuperar los datos del usuario.");
                                    }
                                },
                                error: function () {
                                    alert("Error al recuperar los datos del usuario.");
                                }
                            });

                        } else {
                            alert("Credenciales incorrectas. Intenta de nuevo.");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error AJAX:", xhr.status, error);
                        alert("Error al intentar iniciar sesión. Por favor, intenta más tarde.");
                    }
                });
            });
        });
    </script>
}


