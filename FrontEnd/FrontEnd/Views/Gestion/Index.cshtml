@{
    ViewBag.Title = "Panel de Administración";
}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@Url.Action("Index", "Gestion")">Panel de Gestión</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Home")">Cerrar sesión</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<h1 class="mb-4 text-center">Panel de Administración</h1>
<link rel="stylesheet" href="~/Content/Gestion.css">

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm p-4 text-center">
            <h4>Usuarios</h4>
            <p>Gestiona los usuarios registrados.</p>
            <a href="@Url.Action("Index", "GesUsuarios")" class="btn btn-outline-primary">Ver Usuarios</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm p-4 text-center">
            <h4>Clientes</h4>
            <p>Gestiona los clientes registrados.</p>
            <a href="@Url.Action("Index", "GesClientes")" class="btn btn-outline-primary">Ver Clientes</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm p-4 text-center">
            <h4>Productos</h4>
            <p>Agrega, edita o elimina productos.</p>
            <a href="@Url.Action("Index", "GesProductos")" class="btn btn-outline-primary">Gestionar Productos</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm p-4 text-center">
            <h4>Facturas</h4>
            <p>Consulta y administra pedidos.</p>
            <a href="@Url.Action("Index", "GesFacturas")" class="btn btn-outline-primary">Ver Órdenes</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm p-4 text-center">
            <h4>Estadísticas</h4>
            <p>Consulta métricas importantes.</p>
            <a href="@Url.Action("Estadistica", "Gestion")" class="btn btn-outline-primary">Ver Estadísticas</a>
        </div>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-12">
        <p class="text-muted">Bienvenido al panel de administración. Aquí puedes controlar los datos de tu sistema.</p>
    </div>
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-3 mt-5">
    <p class="mb-0">&copy; @DateTime.Now.Year AdminDB. Todos los derechos reservados.</p>
</footer>